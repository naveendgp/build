{
  "name": "otter-partner",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "svg-icons": "svgr --native src/assets/icons/svg/*.svg --out-dir src/assets/auto-generated-svg-icons",
   "bundle:android": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "build:debug": "npm run bundle:android && cd android && gradlew assembleDebug",
    "build:release": "npm run bundle:android && cd android && gradlew assembleRelease",
    "build:aab": "npm run bundle:android && cd android && gradlew bundleRelease"
  },
